# Mesmo PostgreSQL do CNPJ ETL. O serviço escreve somente no schema outreach.
DATABASE_URL=postgresql://cnpj:cnpj@localhost:5432/cnpj

# SendPulse SMTP. Copie login e senha em Configurações SMTP > Geral.
EMAIL_PROVIDER=sendpulse_smtp
SMTP_HOST=smtp-pulse.com
SMTP_PORT=587
SMTP_USERNAME=COLOQUE_SEU_LOGIN_SMTP
SMTP_PASSWORD=COLOQUE_SUA_SENHA_SMTP
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=30

# Remetente e domínio precisam estar verificados na SendPulse.
OUTREACH_FROM_EMAIL=contato@seudominio.com.br
OUTREACH_FROM_NAME=Tironi Tech
OUTREACH_REPLY_TO=contato@seudominio.com.br

# URL pública usada no link de descadastro.
PUBLIC_BASE_URL=http://localhost:8000
UNSUBSCRIBE_SECRET=gere-uma-chave-aleatoria-longa
API_KEY=gere-uma-chave-para-proteger-a-api
CRON_SECRET=gere-uma-chave-aleatoria-para-o-cron
SENDPULSE_WEBHOOK_SECRET=gere-uma-chave-para-o-webhook

# Proteções padrão. Mantenha aprovação manual no início.
REQUIRE_MANUAL_APPROVAL=true
DAILY_EMAIL_LIMIT=400
HOURLY_EMAIL_LIMIT=50
MAX_PER_DOMAIN_PER_DAY=2
MAX_FOLLOW_UPS=1
FOLLOW_UP_DELAY_DAYS=7
SEND_INTERVAL_SECONDS=72
# Mantém somente um dia de mensagens prontas; novos melhores leads repõem a fila.
PREPARED_QUEUE_TARGET=400
# Pausa preventiva: abaixo dos limites de 7% de bounce e 0,4%-0,5% de spam.
REPUTATION_MIN_SAMPLE=20
MAX_BOUNCE_RATE_PERCENT=5
MAX_COMPLAINT_RATE_PERCENT=0.2
SEND_START_HOUR=9
SEND_END_HOUR=17
APP_TIMEZONE=America/Sao_Paulo
WORKER_POLL_SECONDS=15
DRY_RUN=true

